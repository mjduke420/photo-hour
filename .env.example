# Host port the app is published on. Change this if it collides with
# something already running on your Docker host.
PHOTO_HOUR_PORT=1830

# Port the Fastify server listens on inside the container. There is rarely
# any reason to change this, since only the host port above is exposed.
PORT=8080

# Optional. If set, satellite + vector basemaps unlock in the layer switcher.
# Get a free key at https://cloud.maptiler.com/account/keys/
MAPTILER_KEY=

# Where downloaded DEM tiles are cached on disk (mounted as a volume in compose)
DEM_CACHE_DIR=/data/dem-cache

# Max size of the on-disk DEM cache in megabytes before oldest tiles are evicted
DEM_CACHE_MAX_MB=2048

# Set to true ONLY if the app is actually reachable over HTTPS, e.g. behind a
# TLS reverse proxy. It enables HSTS and upgrade-insecure-requests. Turning it
# on without TLS in front makes the browser rewrite asset requests to https,
# which fails and leaves a blank page.
FORCE_HTTPS=false

# Contact string sent as User-Agent to the geocoder, per Nominatim usage policy
NOMINATIM_USER_AGENT=photo-hour/1.0 (https://github.com/mjduke420/photo-hour)
